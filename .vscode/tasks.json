{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Mock Server",
      "type": "shell",
      "command": "npm run mock-server",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^(never matches)$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Mock API server (listening|already running)"
        }
      }
    },
    {
      "label": "adb reverse mock server",
      "type": "shell",
      "command": "adb reverse tcp:4000 tcp:4000",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Prepare Android DEV (mock server + adb reverse)",
      "dependsOn": ["Start Mock Server", "adb reverse mock server"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
