#!/usr/bin/env php
<?php

declare(strict_types=1);

// apc — this project's CLI (gerogo console), the same idea as Laravel's
// `artisan` or Spring Boot's actuator/admin tooling: operational commands
// that sit next to the app, not behind an HTTP route.
//
//   php apc -v                            app + every package's version
//   php apc start [host:port]             clean + rebuild, then start PHP's built-in server (default host 127.0.0.1, port from PORT in .env.<flavour>, else 7070)
//   php apc stop                          stop the ONE server a matching `apc start` began, wherever it's running
//   php apc build                         regenerate runner/ in place, force-compile + cache the route table (deploy-time build step)
//   php apc build -c | --clean            delete the whole runner/ folder first, then build as above
//   php apc clean                         delete the whole runner/ folder (and route cache) — no rebuild
//   php apc ... -f, --flavour <name>      which .env.<name> to boot from — local, production, staging, or any other name a real APP_ENV happens to carry (else that env var, else 'local')
//   php apc install [version]             no module (or `gerogo`): validate every module's resolved version
//   php apc install <name> [version]      any other module: show/validate its own resolved info
//
// Runs the exact same Runner::boot() as an HTTP request would (module
// resolution, route compiling/caching rules included) — this is not a
// separate config path, just a different front door onto the same Runner.

$basePath = __DIR__;

require_once "$basePath/vendor/autoload.php";

use Gerogo\Cli\Application;
use Gerogo\Runner;

// -f/--flavour <name> (or --flavour=<name>) is this app's one and only
// environment selector — "flavour" and "env" mean the same thing here
// (see Runner::boot()'s own comment) — resolved here, before the very
// first Runner::boot(), since env vars loaded from a .env file are
// locked in for the rest of the process (see Runner::loadEnvFile()'s
// $_ENV[$key] ??= $value) — deciding this any later (e.g. inside
// BuildCommand, after boot() already ran once) would be too late to
// have any effect.
$cliArgs = array_slice($argv, 1);
$flavour = null;
$remaining = [];

for ($i = 0, $count = count($cliArgs); $i < $count; $i++) {
    $arg = $cliArgs[$i];

    if ($arg === '-f' || $arg === '--flavour') {
        if ($flavour !== null) {
            fwrite(STDERR, "Only one -f/--flavour at a time.\n");

            exit(1);
        }

        $flavour = $cliArgs[++$i] ?? null;

        if ($flavour === null) {
            fwrite(STDERR, "-f/--flavour needs a value, e.g. -f production.\n");

            exit(1);
        }

        continue;
    }

    if (str_starts_with($arg, '--flavour=')) {
        if ($flavour !== null) {
            fwrite(STDERR, "Only one -f/--flavour at a time.\n");

            exit(1);
        }

        $flavour = substr($arg, strlen('--flavour='));

        continue;
    }

    $remaining[] = $arg;
}

Runner::boot($basePath, $flavour);

exit((new Application($basePath))->run($remaining));
