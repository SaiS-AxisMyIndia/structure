{
  // Matches .env.dev's DB_* values exactly (root, no password, local
  // MySQL) — update these if your real .env diverges (different host,
  // a real password, etc.). Open the SQLTools sidebar icon, expand
  // "gerogo (local)", and it connects.
  "sqltools.connections": [
    {
      "name": "gerogo (local)",
      "driver": "MySQL",
      "server": "127.0.0.1",
      "port": 3306,
      "database": "gerogo",
      "username": "root",
      "password": ""
    }
  ]
}
